# =============================================================================
# OctoScribe — Environment Variables Template
# =============================================================================
#
# Copy this file to .env (one directory up, at the project root) and fill in
# your real values:
#
#   cp conf/.env.example .env
#
# NEVER commit the .env file to version control. It is listed in .gitignore.
# All secrets MUST live here — never in conf/octoscribe.ini.
#
# Alternatively, export each variable in your shell profile or pass them
# directly as environment variables when running octoscribe.py.
#
# To use a non-default path for this file, set OCTOSCRIBE_ENV before running:
#   OCTOSCRIBE_ENV=/path/to/my.env python octoscribe.py run
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram API credentials (REQUIRED)
# -----------------------------------------------------------------------------
#
# Obtain these from https://my.telegram.org:
#   1. Log in with your Telegram phone number.
#   2. Click "API development tools".
#   3. Create a new application (name and platform do not matter for a bot).
#   4. Copy the api_id (integer) and api_hash (hex string) shown on the page.
#
# These credentials identify YOUR Telegram account. Keep them private.
# Anyone with your api_id + api_hash can act as your account.

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_hex_string_here

# Your phone number in international format, including the country code.
# Example for South Africa: +27821234567
# Example for United States: +12025551234
TELEGRAM_PHONE=+27821234567


# -----------------------------------------------------------------------------
# OpenAI API key (required when transcribe.backend = openai)
# -----------------------------------------------------------------------------
#
# Obtain from https://platform.openai.com/api-keys
# Required only when you use the OpenAI transcription backend (gpt-4o-transcribe).
# Leave blank or omit entirely if you are using the local Faster-Whisper backend.

OPENAI_API_KEY=sk-proj-your_openai_api_key_here


# -----------------------------------------------------------------------------
# Data repository remote URL (optional)
# -----------------------------------------------------------------------------
#
# Git remote URL for the data repository that stores audio files, transcriptions,
# and manifest.json. If set, OctoScribe will add this remote on first run and
# push automatically after each successful pipeline run (requires auto_push = true
# in conf/octoscribe.ini).
#
# Use SSH-style URLs for passwordless authentication:
#   git@github.com:your-username/sermons-data.git
#
# HTTPS URLs also work but require credentials (consider a token in the URL or
# a credential helper):
#   https://github.com/your-username/sermons-data.git

DATA_REPO_URL=git@github.com:your-username/sermons-data.git


# -----------------------------------------------------------------------------
# Config path overrides (optional)
# -----------------------------------------------------------------------------
#
# Override the default paths OctoScribe uses to locate its config file and
# this .env file. Useful for running multiple instances with different configs,
# or when the files are stored in non-standard locations.
#
# Default for OCTOSCRIBE_CONFIG: conf/octoscribe.ini (relative to project root)
# Default for OCTOSCRIBE_ENV:    .env (relative to project root)

# OCTOSCRIBE_CONFIG=/path/to/custom/octoscribe.ini
# OCTOSCRIBE_ENV=/path/to/custom/.env
