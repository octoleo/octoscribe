# =============================================================================
# OctoScribe — Environment Variables Template
# =============================================================================
#
# Copy this file to .env (one directory up, at the project root) and replace
# every placeholder you enable:
#
#   cp conf/.env.example .env
#
# NEVER commit .env. Secrets belong here or in the runner's secret store, never
# in conf/octoscribe.ini or either evidence repository.
#
# To use a non-default environment file:
#   OCTOSCRIBE_ENV=/path/to/my.env python octoscribe.py run
# =============================================================================


# -----------------------------------------------------------------------------
# Telegram (required only when source.mode = telegram)
# -----------------------------------------------------------------------------
# Obtain API credentials from https://my.telegram.org. Folder ingestion does
# not require any of these values.

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_hex_string_here
TELEGRAM_PHONE=+27821234567

# CI runners also need a saved Telethon session. Prefer the GitHub secret named
# TELEGRAM_SESSION_B64 instead of storing this high-value value in a local file.
# TELEGRAM_SESSION_B64=base64_encoded_octoscribe_session


# -----------------------------------------------------------------------------
# Speech-to-text providers (enable one to three)
# -----------------------------------------------------------------------------
# If OCTOSCRIBE_ASR_PROVIDERS is omitted, configured providers are discovered
# in this deterministic order: OpenAI, xAI, Meta. OpenAI therefore remains the
# primary/default path whenever OPENAI_API_KEY is present. Set the list
# explicitly to enable exactly the providers you want or to include whisper.
#
# One provider:  transcription only
# Two providers: independent transcription and cross-check
# Three providers: third is a bounded fallback checker or final arbiter

# OpenAI transcription (recommended primary/default).
# Obtain a key from https://platform.openai.com/api-keys.
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
# TRANSCRIBE_MODEL=gpt-transcribe
# TRANSCRIBE_LANGUAGE=en

# xAI/Grok speech-to-text (optional independent provider).
# XAI_API_KEY=xai-your_api_key_here
# XAI_STT_URL=https://api.x.ai/v1/stt

# Meta ASR hosted behind an OpenAI-compatible /v1/audio/transcriptions API.
# META_ASR_URL=http://127.0.0.1:8000
# META_ASR_API_KEY=optional_private_endpoint_token
# META_ASR_MODEL=omniASR_LLM_Unlimited_7B_v2
# META_ASR_LANGUAGE=eng_Latn
# A normal text-only Llama/Ollama endpoint is not an audio transcriber; only set
# META_ASR_URL when that service actually accepts audio transcription requests.

# Explicit provider policy (optional). Order is significant; maximum three.
# OCTOSCRIBE_ASR_PROVIDERS=openai,xai,meta
# OCTOSCRIBE_PRIMARY_ASR=openai
# ASR_TIMEOUT_SECONDS=900


# -----------------------------------------------------------------------------
# Caller-owned workspace paths
# -----------------------------------------------------------------------------
# OctoScribe reads and writes local directories only. It never clones, pulls,
# commits, or pushes them. A GitHub workflow should use octoleo/git-user@v2,
# clone its desired repositories, pass the resulting paths to OctoScribe, and
# publish the changes afterward. Configure both split paths together:
# AUDIO_REPO_PATH=~/.octoscribe/audio-data
# TRANSCRIPT_REPO_PATH=~/.octoscribe/transcript-data

# Or use one shared path. Do not set it with split paths.
# DATA_REPO_PATH=~/.octoscribe/data

# Source revision provenance is supplied by the caller on the transcribe
# command/action input after it has committed exact audio bytes. It is not a
# repository credential and is intentionally not discovered from a remote.


# -----------------------------------------------------------------------------
# Config path overrides (optional)
# -----------------------------------------------------------------------------
# Default OCTOSCRIBE_CONFIG: conf/octoscribe.ini (project-relative)
# Default OCTOSCRIBE_ENV:    .env (project-relative)

# OCTOSCRIBE_CONFIG=/path/to/custom/octoscribe.ini
# OCTOSCRIBE_ENV=/path/to/custom/.env
