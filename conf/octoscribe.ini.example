# =============================================================================
# OctoScribe — Configuration File Template
# =============================================================================
#
# Copy this file to conf/octoscribe.ini and adjust non-secret settings:
#
#   cp conf/octoscribe.ini.example conf/octoscribe.ini
#
# Keep API keys, tokens, and phone numbers in .env or the CI secret store.
# Never place secrets or Telegram sessions in an evidence worktree.
#
# To use a non-default configuration file:
#   OCTOSCRIBE_CONFIG=/path/to/custom.ini python octoscribe.py run
# =============================================================================


# -----------------------------------------------------------------------------
# [source] — Where sermon audio comes from
# -----------------------------------------------------------------------------
[source]

# telegram: download from [telegram]. Requires Telegram credentials.
# folder: import existing audio from folder below; Telegram is not required.
mode = telegram

# Used only in folder mode. Recognised audio files are copied into the audio
# repository and then enter the same manifest, transcription, and logging path.
# Example: folder = ~/sermons/incoming
folder =
recursive = true


# -----------------------------------------------------------------------------
# [telegram] — Group monitored in Telegram mode
# -----------------------------------------------------------------------------
[telegram]

# @username, t.me link, or numeric chat ID such as -1001234567890.
group = @your_group_or_chat_id


# -----------------------------------------------------------------------------
# [download] — Audio acquisition
# -----------------------------------------------------------------------------
[download]

workers = 4
resume = true
deduplicate = true


# -----------------------------------------------------------------------------
# [transcribe] — Provider selection and request policy
# -----------------------------------------------------------------------------
[transcribe]

# By default, OctoScribe discovers providers from configured environment
# credentials in this order: openai, xai, meta. OpenAI is therefore primary
# whenever OPENAI_API_KEY exists. With one provider it transcribes once; two
# cross-check one another; a third is a bounded fallback checker or arbiter.
#
# Uncomment to choose the exact provider set (order is significant; max three):
# providers = openai,xai,meta
# primary_provider = openai
#
# Legacy single-provider configurations remain supported. Do not set backend
# together with providers; an explicit providers list is the new interface.
# backend = openai

# OpenAI model. Other providers use their own configured model identifiers.
model = gpt-transcribe
language = en

# Parallel provider/API work and transport failure retries.
workers = 4
retry_attempts = 1
retry_base_delay = 2.5
retry_max_delay = 30.0
provider_timeout_seconds = 900


# -----------------------------------------------------------------------------
# [chunking] — Deterministic long-audio preparation
# -----------------------------------------------------------------------------
# ffmpeg/ffprobe are required. Chunks are hashed so every provider can be shown
# to have received identical audio bytes. Values below keep OpenAI WAV uploads
# under its request-size limit while retaining overlap around boundaries.
[chunking]

target_seconds = 480
max_seconds = 600
overlap_seconds = 12
silence_search_seconds = 45
silence_threshold_db = -35
silence_min_ms = 500
max_chunk_megabytes = 24


# -----------------------------------------------------------------------------
# [quality] — Hard bounds on discrepancy resolution
# -----------------------------------------------------------------------------
# Each limit may be 0 or 1. The pipeline never enters an unbounded correction
# loop and never silently rewrites a sermon from a naive word majority.
[quality]

disagreement_retry_limit = 1
arbitration_limit = 1


# -----------------------------------------------------------------------------
# Provider endpoints (credentials stay in .env)
# -----------------------------------------------------------------------------
[xai]

base_url = https://api.x.ai/v1/stt

[meta_asr]

# Base URL, /v1 URL, or complete /v1/audio/transcriptions URL for an explicitly
# hosted OpenAI-compatible Meta speech-recognition service. Leaving this blank
# disables Meta auto-discovery. A normal text-only Llama/Ollama endpoint cannot
# transcribe audio and must not be configured here.
url =
model = omniASR_LLM_Unlimited_7B_v2
language = eng_Latn


# -----------------------------------------------------------------------------
# [local_transcribe] — Local Faster-Whisper provider settings
# -----------------------------------------------------------------------------
# To use it explicitly, set providers = whisper above (or include whisper in a
# multi-provider list). CPU mode is substantially slower than a CUDA GPU.
[local_transcribe]

model = large-v3
device = cuda
compute_type = int8_float16
beam_size = 5
best_of = 5
repetition_penalty = 1.0
vad_filter = false
vad_min_silence_ms = 500
vad_speech_pad_ms = 400


# -----------------------------------------------------------------------------
# Caller-owned evidence paths (split layout recommended)
# -----------------------------------------------------------------------------
# These are local directories only. OctoScribe never clones, pulls, commits, or
# pushes them. A calling workflow owns Git and passes already-cloned worktrees.
# Keeping immutable audio and text evidence separate avoids bloating text
# history while retaining a persistent manifest beside transcript evidence.
[audio_repo]

path = ~/.octoscribe/audio-data

[transcript_repo]

path = ~/.octoscribe/transcript-data

# Shared-directory deployments remain supported. To use one worktree, remove
# or comment [audio_repo] and [transcript_repo], then uncomment:
#
# [data_repo]
# path = ~/.octoscribe/data


# -----------------------------------------------------------------------------
# [paths] — Evidence layout
# -----------------------------------------------------------------------------
[paths]

# Relative to audio_repo.path.
audio_dir = audio

# Relative to transcript_repo.path.
transcriptions_dir = transcriptions
manifest_file = manifest.json
artifacts_dir = candidates
reports_dir = reports

# Telegram's SQLite session is a credential. Keep this absolute path outside
# both evidence worktrees. The GitHub Action overrides it with a temporary,
# permission-restricted runner path and removes it after execution.
session_dir = ~/.octoscribe/session
